---
import BaseLayout from '@layouts/BaseLayout.astro';

const year = new Date().getFullYear();
---

<BaseLayout
  bodyClass="bg-proximamente"
  title="Trigra — Página no encontrada (404)"
  description="La página que buscas no existe. Trigra está en construcción."
>
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-20 text-center"
  >
    <!-- Logo de Trigra -->
    <img
      src="/images/logo-trigra.webp"
      alt="Trigra"
      transition:name="logo-trigra"
      class="w-52 max-w-[70vw] sm:w-64"
      width="320"
      height="120"
    />

    <!-- Ilustración de error 404 -->
    <img
      src="/icons/icon-error404.png"
      alt="Error 404"
      class="mt-4 w-80 max-w-[85vw] drop-shadow-[0_20px_45px_rgba(0,0,0,0.55)] sm:w-96 md:w-[28rem]"
      width="448"
      height="448"
    />

    <!-- Mensaje -->
    <h1
      class="mt-2 font-display text-2xl font-bold tracking-tight sm:text-3xl"
    >
      Página no encontrada
    </h1>
    <p class="mt-4 max-w-md text-base text-trigra-muted sm:text-lg">
      La ruta que buscas no existe o aún estamos construyéndola.
    </p>

    <!-- Volver al inicio -->
    <a
      href="/"
      class="mt-10 inline-flex items-center gap-2 rounded-2xl border border-[#A2AFBB] bg-white/5 px-6 py-2.5 font-display text-base font-medium text-trigra-text transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-trigra-accent/50 sm:text-lg"
    >
      ← Volver al inicio
    </a>

    <!-- Footer -->
    <footer class="absolute bottom-6 text-sm text-trigra-muted">
      © {year} Trigra. Todos los derechos reservados.
    </footer>
  </main>
</BaseLayout>
