---
// Carrusel a pantalla completa para las imágenes de la galería "Vista del proyecto".
// Uno solo para toda la página: se abre al pulsar cualquier [data-lightbox-item]
// y recorre las imágenes del mismo grupo ([data-gallery-panel]).
---

<dialog id="lightbox" class="lightbox m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-white" aria-label="Galería de imágenes">
  <div data-lightbox-stage class="relative flex h-full w-full touch-pan-y select-none flex-col items-center justify-center px-4 py-20 sm:px-24">
    <!-- Contador -->
    <p id="lightbox-counter" class="absolute left-4 top-5 font-display text-sm tracking-wider text-gray-300 sm:left-6 sm:top-6" aria-live="polite"></p>

    <!-- Cerrar -->
    <button
      type="button"
      data-lightbox-close
      class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-[#0B131C]/90 transition-colors hover:bg-[#1A2633] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 sm:right-6 sm:top-6"
      aria-label="Cerrar galería"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <!-- Imagen -->
    <figure class="flex w-full max-w-6xl flex-col items-center">
      <img
        id="lightbox-img"
        alt=""
        class="max-h-[75vh] w-auto max-w-full rounded-lg object-contain shadow-2xl shadow-black/60"
        decoding="async"
      />
      <figcaption id="lightbox-caption" class="mt-4 text-center text-sm text-gray-300"></figcaption>
    </figure>

    <!-- Anterior / siguiente -->
    <button
      type="button"
      data-lightbox-prev
      class="lightbox-nav left-2 sm:left-6"
      aria-label="Imagen anterior"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <button
      type="button"
      data-lightbox-next
      class="lightbox-nav right-2 sm:right-6"
      aria-label="Imagen siguiente"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>

    <!-- Puntos de posición -->
    <div id="lightbox-dots" class="absolute bottom-6 left-1/2 flex -translate-x-1/2 gap-2" aria-hidden="true"></div>
  </div>
</dialog>

<style>
  /* Sin blur: con backdrop-filter el scroll/animación se sentía con lag */
  .lightbox::backdrop {
    background: rgb(3 11 19 / 0.92);
  }
  .lightbox[open] {
    animation: lightbox-in 0.25s ease;
  }
  .lightbox[open]::backdrop {
    animation: lightbox-in 0.25s ease;
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    display: flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(11 19 28 / 0.9);
    transform: translateY(-50%);
    transition: background-color 0.2s;
  }
  .lightbox-nav:hover {
    background: #1a2633;
  }
  .lightbox-nav:focus-visible {
    outline: 2px solid rgb(255 255 255 / 0.5);
    outline-offset: 2px;
  }

  :global(.lightbox-dot) {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.3);
    transition:
      width 0.3s,
      background-color 0.3s;
  }
  :global(.lightbox-dot.is-active) {
    width: 1.5rem;
    background: #007bc5;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open],
    .lightbox[open]::backdrop {
      animation: none;
    }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const counter = document.getElementById('lightbox-counter');
  const dots = document.getElementById('lightbox-dots');
  const prevBtn = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextBtn = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const stage = dialog?.querySelector<HTMLElement>('[data-lightbox-stage]');

  type Item = { src: string; alt: string };
  let items: Item[] = [];
  let index = 0;
  let token = 0; // evita que una imagen que tarda en cargar pise a la siguiente

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Descarga por adelantado las imágenes vecinas para que el cambio sea instantáneo
  const preload = (i: number) => {
    const item = items[(i + items.length) % items.length];
    if (item) new Image().src = item.src;
  };

  // Muestra la imagen actual; dir = -1 (anterior), 1 (siguiente) o 0 (al abrir)
  const render = async (dir: number) => {
    if (!img || !items.length) return;
    const item = items[index];
    const current = ++token;

    if (counter) counter.textContent = `${index + 1} / ${items.length}`;
    if (caption) caption.textContent = item.alt;
    dots?.querySelectorAll('.lightbox-dot').forEach((d, i) => d.classList.toggle('is-active', i === index));

    img.style.opacity = '0';
    img.src = item.src;
    img.alt = item.alt;
    try {
      await img.decode();
    } catch {
      /* si falla el decode, se muestra igual */
    }
    if (current !== token) return;

    img.style.opacity = '1';
    if (!reduceMotion()) {
      img.animate(
        [
          { opacity: 0, transform: `translateX(${dir * 40}px) scale(${dir ? 1 : 0.97})` },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
      );
    }
    preload(index + 1);
    preload(index - 1);
  };

  const go = (step: number) => {
    if (items.length < 2) return;
    index = (index + step + items.length) % items.length;
    render(step);
  };

  const open = (list: Item[], start: number) => {
    if (!dialog) return;
    items = list;
    index = start;
    const single = items.length < 2;
    prevBtn?.toggleAttribute('hidden', single);
    nextBtn?.toggleAttribute('hidden', single);
    if (dots) {
      dots.innerHTML = '';
      if (!single) items.forEach(() => dots.appendChild(Object.assign(document.createElement('span'), { className: 'lightbox-dot' })));
    }
    // Se abre encima del modal del proyecto (los <dialog> modales se apilan)
    dialog.showModal();
    render(0);
  };

  // Abrir: cualquier imagen de la galería; el grupo es su panel (web o admin)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-item]');
    if (!trigger) return;
    const group = trigger.closest('[data-gallery-panel]') ?? trigger.parentElement;
    const triggers = [...(group?.querySelectorAll<HTMLElement>('[data-lightbox-item]') ?? [trigger])];
    const list = triggers.map((t) => ({
      src: t.dataset.large ?? t.querySelector('img')?.src ?? '',
      alt: t.querySelector('img')?.alt ?? '',
    }));
    open(list, Math.max(0, triggers.indexOf(trigger)));
  });

  prevBtn?.addEventListener('click', () => go(-1));
  nextBtn?.addEventListener('click', () => go(1));
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

  // Clic en el fondo (fuera de la imagen y los botones) cierra
  stage?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === stage || t.tagName === 'FIGURE') dialog?.close();
  });

  // Teclado: ← → para navegar (Esc cierra de forma nativa)
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      go(1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      go(-1);
    }
  });

  // Deslizar con el dedo en móviles
  let startX: number | null = null;
  stage?.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse') startX = e.clientX;
  });
  stage?.addEventListener('pointerup', (e) => {
    if (startX === null) return;
    const dx = e.clientX - startX;
    startX = null;
    if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
  });

  // Al cerrar, se limpia la imagen para no mostrar la anterior al reabrir
  dialog?.addEventListener('close', () => {
    token++;
    if (img) {
      img.removeAttribute('src');
      img.style.opacity = '0';
    }
  });
</script>
