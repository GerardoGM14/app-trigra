---
// Bloque "Tecnología que respalda cada solución": cinta de logos en bucle infinito.
import fs from 'node:fs';
import path from 'node:path';
import { tecnologias } from '@data/tecnologias';

// Busca el logo en public/images/tecnologias/ (svg, webp o png).
// Solo entran a la cinta las tecnologías que tienen logo.
const items = tecnologias.map((t) => {
  const ext = ['svg', 'webp', 'png'].find((e) =>
    fs.existsSync(path.join(process.cwd(), 'public', 'images', 'tecnologias', `${t.slug}.${e}`))
  );
  return { ...t, logo: ext ? `/images/tecnologias/${t.slug}.${ext}` : null };
}).filter((t) => t.logo);

// Velocidad constante sin importar cuántas tecnologías haya (~3.5 s por logo)
const duration = `${items.length * 3.5}s`;
---

<div class="rounded-2xl bg-[#161F2A] px-6 py-8 sm:px-10 sm:py-10">
  <p data-reveal class="flex items-center gap-3 font-display text-xs uppercase tracking-[0.2em] text-gray-400 sm:text-sm">
    <span class="h-1 w-5 rounded-full bg-[#93FE69]" aria-hidden="true"></span>
    [03] Tecnologías / Con qué trabajamos
  </p>
  <h3 data-reveal style="--enter-delay: 100ms" class="mt-3 font-display text-2xl/tight font-bold tracking-tight sm:text-[2rem]/tight">
    Tecnología que respalda <span class="text-gradient-reverse">cada solución</span>
  </h3>
  <p data-reveal style="--enter-delay: 150ms" class="mt-3 max-w-3xl text-sm text-gray-400 sm:text-base">
    Seleccionamos las herramientas y tecnologías más adecuadas para garantizar soluciones eficientes, seguras y
    preparadas para crecer.
  </p>

  <!-- Cinta en bucle: la lista va dos veces seguidas y se desplaza la mitad de su ancho,
       así el final empalma con el inicio sin salto -->
  <div data-reveal style="--enter-delay: 200ms" class="tech-marquee mt-8 overflow-hidden" aria-label="Tecnologías con las que trabajamos">
    <div class="tech-track flex w-max" style={`--tech-duration: ${duration}`}>
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center gap-10 pr-10 sm:gap-12 sm:pr-12" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((t) => (
              <li class="flex shrink-0 items-center gap-3">
                <img src={t.logo} alt="" class="h-8 w-8 object-contain" width="32" height="32" loading="lazy" decoding="async" />
                <span class="leading-tight">
                  <span class="block whitespace-nowrap font-display text-base font-bold text-white">{t.name}</span>
                  <span class="block whitespace-nowrap text-xs text-gray-400 sm:text-sm">{t.category}</span>
                </span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Bordes difuminados: los logos aparecen y desaparecen suavemente */
  .tech-marquee {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .tech-track {
    animation: tech-scroll var(--tech-duration, 50s) linear infinite;
    will-change: transform;
  }
  /* Se pausa al pasar el mouse para poder leer */
  .tech-marquee:hover .tech-track {
    animation-play-state: paused;
  }

  @keyframes tech-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* Sin animación: la cinta se puede desplazar a mano */
  @media (prefers-reduced-motion: reduce) {
    .tech-track {
      animation: none;
    }
    .tech-marquee {
      overflow-x: auto;
    }
  }
</style>
