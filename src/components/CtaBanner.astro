---
// Banner de llamado a la acción (reutilizable). Por defecto: "¿Tienes un proyecto en mente?".
// Se usa dentro del modal de cada proyecto y en la sección Nosotros.
interface Props {
  /** Dentro de un modal: el botón cierra el modal antes de ir a #contacto */
  inModal?: boolean;
  /** Título: texto normal + parte con degradado + cierre (ej. "?") */
  title?: string;
  highlight?: string;
  titleEnd?: string;
  /** Salto de línea antes de la parte con degradado */
  titleBreak?: boolean;
  text?: string;
  cta?: string;
  /** Texto que se escribe en el campo Mensaje del formulario de contacto */
  prefill?: string;
  class?: string;
}

const {
  inModal = false,
  title = '¿Tienes un',
  highlight = 'proyecto en mente?',
  titleEnd = '',
  titleBreak = false,
  text = 'Cuéntanos qué necesitas y encontremos juntos el mejor camino para hacerlo realidad.',
  cta = 'Hablemos de tu proyecto',
  prefill,
  class: className = '',
} = Astro.props;
---

<div class:list={['cta-banner relative overflow-hidden rounded-xl border border-[#374151] text-trigra-text', className]}>
  <!-- Foto (solo en la parte derecha del banner) -->
  <div class="cta-banner-photo absolute inset-y-0 right-0 w-full sm:w-3/4" aria-hidden="true"></div>
  <!-- Capas oscuras -->
  <div class="cta-banner-overlay absolute inset-0" aria-hidden="true"></div>
  <!-- Red decorativa (esquina inferior derecha) -->
  <img
    src="/icons/icon-red-v2.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-0 w-[85%] max-w-[646px] select-none opacity-[0.69] sm:w-[60%]"
    width="646"
    height="128"
    loading="lazy"
  />

  <div class="relative px-6 py-8 sm:px-9 sm:py-10">
    <h4 class="font-display text-2xl font-bold tracking-tight sm:text-[1.75rem]">
      {title}{titleBreak ? <br /> : ' '}<span class="text-gradient-reverse">{highlight}</span>{titleEnd}
    </h4>
    <p class="mt-2 max-w-md text-sm text-gray-300 sm:text-base">
      {text}
    </p>
    <a
      href="#contacto"
      data-close-modal={inModal ? '' : undefined}
      data-prefill={prefill}
      class="mt-6 inline-flex rounded-lg bg-[#007BC5] px-5 py-2.5 font-display text-sm font-medium text-white transition-colors hover:bg-[#0069A8] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 sm:text-base"
    >
      {cta}
    </a>
  </div>
</div>

<style>
  /* Capas (de arriba hacia abajo):
     1. Lineal izq → der: Vulcan/950 #0A0D10 100% → #0C1116 81% → #121A21 4%
     2. Radial: #030B13 53% → #030B13 87% → Grey-12 #161F2A 100% (opacidades)
     3. Foto background-negociacion.webp
     Borde: #374151 */
  .cta-banner {
    background-color: #161f2a;
  }
  .cta-banner-photo {
    background: url('/images/background-negociacion.webp') center 62% / cover no-repeat;
  }
  .cta-banner-overlay {
    background-image:
      linear-gradient(
        to right,
        rgb(10 13 16 / 1) 0%,
        rgb(12 17 22 / 0.81) 45%,
        rgb(18 26 33 / 0.04) 100%
      ),
      radial-gradient(
        ellipse at 70% 50%,
        rgb(3 11 19 / 0.53) 0%,
        rgb(3 11 19 / 0.87) 75%,
        #161f2a 100%
      );
  }
</style>
