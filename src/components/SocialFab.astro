---
// Botón flotante de redes sociales: fijo en la esquina inferior derecha.
// Al pulsarlo, las redes se despliegan en abanico (cuarto de círculo).
import { networks, type Network } from '@data/social';

const order: Network[] = ['whatsapp', 'linkedin', 'facebook', 'instagram'];

// Posición de cada red al abrirse: ángulos de 270° (arriba) a 180° (izquierda)
const RADIUS = 108; // px desde el centro del botón principal (con 4 redes, evita que se toquen)
const items = order.map((key, i) => {
  const angle = 270 - (90 / (order.length - 1)) * i; // de 270° a 180°, repartidos por igual
  const rad = (angle * Math.PI) / 180;
  return {
    ...networks[key],
    x: Math.round(Math.cos(rad) * RADIUS),
    y: Math.round(Math.sin(rad) * RADIUS), // en CSS, y negativa = hacia arriba
    delay: i * 50,
  };
});
---

<div id="social-fab" class="enter-fade fixed bottom-5 right-5 z-40 sm:bottom-8 sm:right-8" style="--enter-delay: 600ms">
  <!-- Redes (abanico) -->
  <ul id="social-fab-menu" aria-label="Redes sociales">
    {
      items.map((item) => (
        <li
          class="fab-item absolute left-1 top-1"
          style={`--x: ${item.x}px; --y: ${item.y}px; --delay: ${item.delay}ms`}
        >
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.label}
            tabindex="-1"
            class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-[#16202A] transition-colors hover:bg-[#22303F] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
          >
            <img src={item.icon} alt="" aria-hidden="true" class="h-6 w-6" width="24" height="24" />
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Botón principal -->
  <button
    type="button"
    id="social-fab-toggle"
    class="fab-toggle relative flex h-14 w-14 items-center justify-center rounded-full border border-[#A2AFBB] bg-white/15 text-trigra-text transition-colors duration-300 hover:bg-white/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
    aria-expanded="false"
    aria-controls="social-fab-menu"
    aria-label="Mostrar redes sociales"
  >
    <!-- Ícono "compartir" (cerrado) -->
    <svg class="fab-icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path>
    </svg>
    <!-- Ícono "cerrar" (abierto) -->
    <svg class="fab-icon-close absolute h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</div>

<style>
  /* Cerrado: las redes quedan ocultas detrás del botón principal */
  .fab-item {
    opacity: 0;
    visibility: hidden;
    transform: translate(0, 0) scale(0.4);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease,
      visibility 0s linear 0.35s;
  }

  /* Abierto: cada red sale a su posición del abanico, escalonadas */
  #social-fab.is-open .fab-item {
    opacity: 1;
    visibility: visible;
    transform: translate(var(--x), var(--y)) scale(1);
    transition-delay: var(--delay), var(--delay), 0s;
  }

  /* Sobre una sección clara ([data-fab-light]) el vidrio no se vería: fondo oscuro sólido.
     (Sin backdrop-filter: al estar fijo sobre la página, el desenfoque causaba lag al hacer scroll) */
  #social-fab.is-on-light .fab-toggle {
    background-color: rgb(11 19 28 / 0.9);
    border-color: rgb(11 19 28 / 0.9);
  }
  #social-fab.is-on-light .fab-toggle:hover {
    background-color: #1a2633;
  }

  /* Cambio de ícono compartir ↔ cerrar con giro */
  .fab-icon-open,
  .fab-icon-close {
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }
  .fab-icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }
  #social-fab.is-open .fab-icon-open {
    opacity: 0;
    transform: rotate(90deg);
  }
  #social-fab.is-open .fab-icon-close {
    opacity: 1;
    transform: rotate(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .fab-item,
    .fab-icon-open,
    .fab-icon-close {
      transition: none;
    }
  }
</style>

<script>
  function initSocialFab() {
    const root = document.getElementById('social-fab');
    const toggle = document.getElementById('social-fab-toggle');
    if (!root || !toggle) return;
    const links = root.querySelectorAll<HTMLAnchorElement>('.fab-item a');

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Ocultar redes sociales' : 'Mostrar redes sociales');
      // Solo se puede llegar con Tab a las redes cuando están visibles
      links.forEach((a) => (a.tabIndex = open ? 0 : -1));
    };

    toggle.addEventListener('click', () => setOpen(!root.classList.contains('is-open')));

    // Detecta si el botón está encima de una sección clara ([data-fab-light]):
    // se observa solo una franja a la altura del botón (parte baja de la pantalla).
    const lightSections = document.querySelectorAll('[data-fab-light]');
    let observer: IntersectionObserver | null = null;
    const watchBackground = () => {
      observer?.disconnect();
      if (!lightSections.length) return;
      const rect = toggle.getBoundingClientRect();
      const visible = new Set<Element>();
      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => (entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target)));
          root.classList.toggle('is-on-light', visible.size > 0);
        },
        {
          // Franja horizontal que cruza el centro del botón
          rootMargin: `-${Math.round(rect.top + rect.height / 2)}px 0px -${Math.round(window.innerHeight - rect.top - rect.height / 2 - 1)}px 0px`,
        }
      );
      lightSections.forEach((el) => observer?.observe(el));
    };
    watchBackground();
    window.addEventListener('resize', watchBackground);

    // Cerrar al hacer clic fuera o con Esc
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', initSocialFab);
</script>
