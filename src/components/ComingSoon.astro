---
// Sección principal de la landing "en construcción" de Trigra.
const year = new Date().getFullYear();
---

<main
  class="relative flex min-h-screen flex-col items-center overflow-hidden px-6 pt-36 text-center sm:pt-44 md:pt-52"
>
  <!-- Logo de Trigra -->
  <h1 class="sr-only">Trigra</h1>
  <img
    src="/images/logo-trigra.png"
    alt="Trigra"
    transition:name="logo-trigra"
    class="w-64 max-w-[80vw] sm:w-80 md:w-[24rem]"
    width="384"
    height="144"
  />

  <!-- Pill: estado de la página -->
  <p
    class="mt-8 inline-flex items-center gap-2.5 rounded-2xl border border-[#A2AFBB] bg-white/5 px-5 py-1 font-display text-base font-medium leading-tight text-trigra-text sm:text-lg"
  >
    <img
      src="/icons/icon-obras.webp"
      alt=""
      aria-hidden="true"
      class="h-5 w-5 sm:h-6 sm:w-6"
      width="24"
      height="24"
    />
    Página en construcción
  </p>

  <!-- Titular con gradiente -->
  <h2
    class="mt-10 max-w-4xl font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
  >
    Construyendo <span class="text-gradient">soluciones digitales</span> inteligentes...
  </h2>

  <!-- Mensaje -->
  <p class="mt-6 max-w-xl text-lg text-trigra-muted sm:text-xl">
    Estamos construyendo algo increíble. Muy pronto podrás conocer todo lo que
    <span class="text-trigra-text">Trigra</span> tiene preparado para ti.
  </p>

  <!-- Formulario de aviso (opcional, aún sin backend) -->
  <form
    class="mt-10 flex w-full max-w-md flex-col gap-3 sm:flex-row"
    onsubmit="event.preventDefault();"
  >
    <input
      type="email"
      required
      placeholder="tu@correo.com"
      aria-label="Correo electrónico"
      class="flex-1 rounded-xl border border-white/10 bg-trigra-surface px-4 py-3 text-trigra-text placeholder:text-trigra-muted focus:border-trigra-accent focus:outline-none focus:ring-2 focus:ring-trigra-accent/40"
    />
    <button
      type="submit"
      class="rounded-xl bg-trigra-accent px-6 py-3 font-display font-medium text-white transition hover:bg-trigra-accent-soft focus:outline-none focus:ring-2 focus:ring-trigra-accent/60"
    >
      Avísame
    </button>
  </form>

  <!-- Redes sociales -->
  <nav class="mt-8 flex items-center gap-2" aria-label="Redes sociales">
    <!-- Facebook -->
    <a
      href="#"
      aria-label="Facebook"
      class="flex h-[52px] w-[52px] items-center justify-center rounded-full bg-[#16202A] text-trigra-text transition hover:bg-trigra-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-trigra-accent/60"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073c0 6.026 4.388 11.021 10.125 11.927v-8.437H7.078v-3.49h3.047V9.41c0-3.017 1.792-4.684 4.533-4.684 1.313 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796v8.437C19.612 23.094 24 18.099 24 12.073Z"
        ></path>
      </svg>
    </a>

    <!-- Instagram -->
    <a
      href="#"
      aria-label="Instagram"
      class="flex h-[52px] w-[52px] items-center justify-center rounded-full bg-[#16202A] text-trigra-text transition hover:bg-trigra-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-trigra-accent/60"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"
        ></path>
      </svg>
    </a>

    <!-- WhatsApp -->
    <a
      href="#"
      aria-label="WhatsApp"
      class="flex h-[52px] w-[52px] items-center justify-center rounded-full bg-[#16202A] text-trigra-text transition hover:bg-trigra-accent hover:text-white focus:outline-none focus:ring-2 focus:ring-trigra-accent/60"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24Zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981Zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.166-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414Z"
        ></path>
      </svg>
    </a>
  </nav>

  <!-- Footer -->
  <footer class="absolute bottom-6 text-sm text-trigra-muted">
    © {year} Trigra. Todos los derechos reservados.
  </footer>
</main>
