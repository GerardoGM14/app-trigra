---
// Sección principal de la landing "en construcción" de Trigra.
const year = new Date().getFullYear();

// WhatsApp: número de contacto + mensaje predefinido.
const whatsappPhone = '51934367672'; // formato internacional sin '+' ni espacios
const whatsappMessage =
  '¡Hola Trigra! 👋 Estoy interesado en adquirir uno de sus servicios. ¿Me pueden dar más información?';
const whatsappUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(whatsappMessage)}`;
---

<main
  class="relative flex min-h-screen flex-col items-center overflow-hidden px-6 pt-36 text-center sm:pt-44 md:pt-[10.5rem]"
>
  <!-- Logo de Trigra -->
  <h1 class="sr-only">Trigra</h1>
  <img
    src="/images/logo-trigra.png"
    alt="Trigra"
    transition:name="logo-trigra"
    class="w-64 max-w-[80vw] sm:w-80 md:w-[24rem]"
    width="384"
    height="144"
  />

  <!-- Pill: estado de la página -->
  <p
    class="mt-8 inline-flex items-center gap-2.5 rounded-2xl border border-[#A2AFBB] bg-white/5 px-5 py-1 font-display text-base font-medium leading-tight text-trigra-text sm:text-lg"
  >
    <img
      src="/icons/icon-obras.webp"
      alt=""
      aria-hidden="true"
      class="h-5 w-5 sm:h-6 sm:w-6"
      width="24"
      height="24"
    />
    Página en construcción
  </p>

  <!-- Titular con gradiente -->
  <h2
    class="mt-16 max-w-4xl font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
  >
    Construyendo <span class="text-gradient">soluciones digitales</span> inteligentes...
  </h2>

  <!-- Mensaje -->
  <p class="mt-6 max-w-3xl text-lg text-gray-200 sm:text-xl">
    En <span class="text-trigra-text">Trigra</span> estamos afinando los últimos
    detalles de nuestro sitio. Muy pronto descubrirás cómo transformamos procesos
    manuales en sistemas web, aplicaciones y herramientas digitales a medida.
  </p>

  <!-- Redes sociales -->
  <nav class="mt-20 flex items-center gap-4" aria-label="Redes sociales">
    <a
      href="https://www.facebook.com/Gdegato.3/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook"
      class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#16202A] transition hover:bg-[#22303F] focus:outline-none focus:ring-2 focus:ring-white/20"
    >
      <img src="/icons/icon-facebook.svg" alt="" aria-hidden="true" class="h-8 w-8" width="32" height="32" />
    </a>

    <a
      href="https://www.instagram.com/gerardogm_14/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#16202A] transition hover:bg-[#22303F] focus:outline-none focus:ring-2 focus:ring-white/20"
    >
      <img src="/icons/icon-instagram.svg" alt="" aria-hidden="true" class="h-8 w-8" width="32" height="32" />
    </a>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp"
      class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#16202A] transition hover:bg-[#22303F] focus:outline-none focus:ring-2 focus:ring-white/20"
    >
      <img src="/icons/icon-wsp.svg" alt="" aria-hidden="true" class="h-8 w-8" width="32" height="32" />
    </a>
  </nav>

  <!-- Footer -->
  <footer class="absolute bottom-6 text-sm text-trigra-muted">
    © {year} Trigra. Todos los derechos reservados.
  </footer>
</main>
