---
// Sección principal de la landing "en construcción" de Trigra.
const year = new Date().getFullYear();
---

<main
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center"
>
  <!-- Halo de fondo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-1/3 -z-10 h-[40rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-trigra-accent/20 blur-[120px]"
  >
  </div>

  <!-- Logo de Trigra -->
  <h1 class="sr-only">Trigra</h1>
  <img
    src="/images/logo-trigra.png"
    alt="Trigra"
    class="w-56 max-w-[70vw] sm:w-72 md:w-80"
    width="320"
    height="120"
  />

  <!-- Mensaje -->
  <p class="mt-6 max-w-xl text-lg text-trigra-muted sm:text-xl">
    Estamos construyendo algo increíble. Muy pronto podrás conocer todo lo que
    <span class="text-trigra-text">Trigra</span> tiene preparado para ti.
  </p>

  <!-- Formulario de aviso (opcional, aún sin backend) -->
  <form
    class="mt-10 flex w-full max-w-md flex-col gap-3 sm:flex-row"
    onsubmit="event.preventDefault();"
  >
    <input
      type="email"
      required
      placeholder="tu@correo.com"
      aria-label="Correo electrónico"
      class="flex-1 rounded-xl border border-white/10 bg-trigra-surface px-4 py-3 text-trigra-text placeholder:text-trigra-muted focus:border-trigra-accent focus:outline-none focus:ring-2 focus:ring-trigra-accent/40"
    />
    <button
      type="submit"
      class="rounded-xl bg-trigra-accent px-6 py-3 font-display font-medium text-white transition hover:bg-trigra-accent-soft focus:outline-none focus:ring-2 focus:ring-trigra-accent/60"
    >
      Avísame
    </button>
  </form>

  <!-- Footer -->
  <footer class="absolute bottom-6 text-sm text-trigra-muted">
    © {year} Trigra. Todos los derechos reservados.
  </footer>
</main>
