---
// Barra de navegación flotante de la página principal.
// Cada enlace apunta al id de su sección; el activo se resalta al hacer scroll.
const links = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Soluciones', href: '#soluciones' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'Nosotros', href: '#nosotros' },
];
const cta = {
  label: 'Trabajemos juntos',
  href: '#contacto',
  // Texto que se escribe en el campo Mensaje del formulario de contacto
  prefill: 'Hola, me gustaría trabajar con TRIGRA en un proyecto.',
};
---

<header class="enter-down fixed inset-x-0 top-4 z-50 px-4 sm:top-6 sm:px-6">
  <nav
    id="navbar"
    class="mx-auto max-w-5xl rounded-2xl border-b border-white/10 bg-[#161F2A]"
    aria-label="Navegación principal"
  >
    <div class="flex items-center justify-between gap-4 py-2.5 pl-5 pr-2.5 md:py-2 lg:pl-6">
      <!-- Logo -->
      <a href="#inicio" class="shrink-0 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30">
        <img
          src="/images/logo-trigra.webp"
          alt="Trigra — inicio"
          class="h-8 w-auto lg:h-9"
          width="800"
          height="235"
        />
      </a>

      <!-- Enlaces (escritorio) -->
      <ul id="nav-links" class="relative hidden items-center gap-1 md:flex lg:gap-3">
        <!-- Indicador deslizante: se mueve bajo la opción activa -->
        <li
          id="nav-indicator"
          aria-hidden="true"
          class="pointer-events-none absolute left-0 top-1/2 h-10 -translate-y-1/2 rounded-lg bg-white/10 opacity-0 ring-1 ring-white/15 transition-[transform,width,opacity] duration-300 ease-out"
        >
        </li>
        {
          links.map((link) => (
            <li class="relative">
              <a
                href={link.href}
                data-nav-link
                class="nav-link block rounded-lg px-3 py-2 font-display text-base text-gray-300 transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 lg:text-lg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <!-- Botón principal -->
        <a
          href={cta.href}
          data-prefill={cta.prefill}
          class="hidden rounded-xl bg-[#007BC5] px-4 py-2 font-display text-sm font-medium text-white transition-colors hover:bg-[#0069A8] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 sm:inline-flex lg:text-base"
        >
          {cta.label}
        </a>

        <!-- Botón de menú (móvil) -->
        <button
          type="button"
          id="nav-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-gray-200 transition-colors hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 md:hidden"
          aria-controls="nav-menu"
          aria-expanded="false"
          aria-label="Abrir menú"
        >
          <svg class="icon-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="icon-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Menú desplegable (móvil) -->
    <div id="nav-menu" class="hidden border-t border-white/10 px-3 pb-3 pt-2 md:hidden">
      <ul class="flex flex-col">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="nav-link block rounded-lg px-3 py-3 font-display text-lg text-gray-300 transition-colors hover:bg-white/5 hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={cta.href}
          data-prefill={cta.prefill}
        class="mt-2 flex justify-center rounded-xl bg-[#007BC5] px-4 py-3 font-display text-base font-medium text-white transition-colors hover:bg-[#0069A8] sm:hidden"
      >
        {cta.label}
      </a>
    </div>
  </nav>
</header>

<style>
  .nav-link.is-active {
    color: #fff;
  }

  /* En el menú móvil no hay indicador deslizante: se resalta con fondo */
  #nav-menu .nav-link.is-active {
    background-color: rgb(255 255 255 / 0.08);
  }

  /* Ocultar/mostrar la barra al llegar al footer (tablet y escritorio).
     Se mueve el <nav> y no el <header>: el header ya tiene la animación de entrada,
     que al terminar fijaría su transform. */
  #navbar {
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }
  header.is-hidden #navbar {
    transform: translateY(calc(-100% - 2rem));
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #nav-indicator,
    #navbar {
      transition: none;
    }
  }
</style>

<script>
  // Tablet y escritorio: la barra se oculta al bajar dentro del footer
  // y reaparece en cuanto se hace scroll hacia arriba.
  function initAutoHide() {
    const header = document.getElementById('navbar')?.closest('header');
    const footer = document.querySelector('footer');
    if (!header || !footer) return;

    const wide = window.matchMedia('(min-width: 768px)');
    let footerVisible = false;
    let lastY = window.scrollY;
    let ticking = false;

    const setHidden = (hidden: boolean) => header.classList.toggle('is-hidden', hidden);

    new IntersectionObserver(
      (entries) => {
        footerVisible = entries.some((e) => e.isIntersecting);
        if (!footerVisible) setHidden(false);
      },
      // El footer cuenta como "alcanzado" cuando su borde superior pasa el 80% de la pantalla
      { rootMargin: '0px 0px -20% 0px' }
    ).observe(footer);

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const delta = y - lastY;
      if (Math.abs(delta) < 4) return; // ignora micro-movimientos
      lastY = y;
      if (!wide.matches) return setHidden(false);
      // Bajando dentro del footer: se oculta. Subiendo: vuelve a aparecer.
      setHidden(footerVisible && delta > 0);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    // Si se navega con el teclado hasta la barra, se muestra
    header.addEventListener('focusin', () => setHidden(false));
    wide.addEventListener('change', () => setHidden(false));
  }

  document.addEventListener('astro:page-load', initAutoHide);

  function initNavbar() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-menu');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    // Cerrar el menú móvil al elegir una sección
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const indicator = document.getElementById('nav-indicator');
    let activeHash = '';

    // Mueve la píldora bajo el enlace activo de escritorio (o la oculta si no hay)
    const moveIndicator = () => {
      if (!indicator) return;
      const target = links.find(
        (a) => a.hash === activeHash && a.closest('#nav-links')
      );
      if (!target) {
        indicator.style.opacity = '0';
        return;
      }
      const li = target.parentElement as HTMLElement;
      indicator.style.width = `${li.offsetWidth}px`;
      indicator.style.transform = `translate(${li.offsetLeft}px, -50%)`;
      indicator.style.opacity = '1';
    };

    const setActive = (hash: string) => {
      activeHash = hash;
      links.forEach((a) => {
        const active = a.hash === hash;
        a.classList.toggle('is-active', active);
        if (active) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      moveIndicator();
    };

    // Al hacer clic, la píldora se desplaza de inmediato a la opción elegida y se
    // ignora el scroll mientras dura el desplazamiento suave, para que no
    // "salte" por las secciones intermedias.
    let lockedUntil = 0;
    links.forEach((a) =>
      a.addEventListener('click', () => {
        lockedUntil = Date.now() + 1000;
        setActive(a.hash);
      })
    );

    window.addEventListener('resize', moveIndicator);

    // Resaltar la opción de la sección visible al hacer scroll.
    // #inicio (hero) también se observa: al volver arriba no queda nada activo.
    const hashes = ['#inicio', ...new Set(links.map((a) => a.hash))];
    const sections = hashes
      .map((hash) => document.querySelector<HTMLElement>(hash))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        if (Date.now() < lockedUntil) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(`#${entry.target.id}`);
        });
      },
      // La sección cuenta como activa cuando cruza la franja central de la pantalla
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => observer.observe(s));
  }

  // Compatible con las transiciones de vista (ClientRouter)
  document.addEventListener('astro:page-load', initNavbar);
</script>
