---
// Ícono de una solución (reutilizable en la card y en el modal).
// Usa el SVG de Figma de public/icons/ insertado en el HTML (no como <img>) y cambia
// su color fijo por currentColor, para que tome el color del texto del contenedor.
// Si falta el SVG, usa un ícono de línea de respaldo.
import fs from 'node:fs';
import path from 'node:path';
import type { SolucionIcon } from '@data/soluciones';

interface Props {
  icon: SolucionIcon;
  /** Tamaño del ícono (clases de Tailwind) */
  class?: string;
}

const { icon, class: sizeClass = 'h-[18px] w-[18px]' } = Astro.props;

const iconFiles: Record<SolucionIcon, string> = {
  web: 'icon-web.svg',
  sistemas: 'icon-sistemas.svg',
  automatizacion: 'icon-automatizacion.svg',
  ia: 'icon-inteligencia.svg',
  integracion: 'icon-integracion.svg',
  dashboards: 'icon-dashboard.svg',
  soporte: 'icon-soporte.svg',
  consultoria: 'icon-consultoria.svg',
};
const iconPath = path.join(process.cwd(), 'public', 'icons', iconFiles[icon]);
const figmaIcon = fs.existsSync(iconPath)
  ? fs
      .readFileSync(iconPath, 'utf8')
      .replace(/\s(width|height)="[^"]*"/g, '')
      .replace(/fill="(?!none)[^"]*"/g, 'fill="currentColor"')
      .replace('<svg', `<svg class="${sizeClass}" aria-hidden="true"`)
  : null;

// Respaldo si falta el SVG de Figma: íconos de línea (24×24, trazo)
const fallback: Record<SolucionIcon, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="15.5" cy="14.5" r="2.5"/>',
  sistemas: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 10h8l-2-2M16 14H8l2 2"/>',
  automatizacion:
    '<rect x="3" y="9.5" width="5" height="5" rx="1"/><rect x="16" y="3" width="5" height="5" rx="1"/><rect x="16" y="16" width="5" height="5" rx="1"/><path d="M8 12h4M12 5.5v13M12 5.5h4M12 18.5h4"/>',
  ia: '<rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 4v4"/><circle cx="12" cy="3.5" r="1"/><circle cx="9.5" cy="13.5" r="1"/><circle cx="14.5" cy="13.5" r="1"/>',
  integracion:
    '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M9 12h6M12 9v6"/>',
  dashboards: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>',
  soporte:
    '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>',
  consultoria:
    '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/>',
};
---

{
  figmaIcon ? (
    <Fragment set:html={figmaIcon} />
  ) : (
    <svg
      class={sizeClass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={fallback[icon]}
    />
  )
}
